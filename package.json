{
  "name": "tree-sitter-julia",
  "version": "0.25.0",
  "description": "Julia grammar for tree-sitter",
  "repository": "https://github.com/tree-sitter/tree-sitter-julia",
  "license": "MIT",
  "author": {
    "name": "Max Brunsfeld",
    "email": "maxbrunsfeld@gmail.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "julia"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.2.2",
    "node-gyp-build": "^4.8.2"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "eslint-config-treesitter": "^1.0.2",
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.26.6",
    "web-tree-sitter": "^0.26.13"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "build:wasm": "tree-sitter build --wasm -o tree-sitter-julia.wasm",
    "prestart": "npm run build:wasm",
    "start": "tree-sitter playground",
    "test": "npm run test:corpus && npm run test:juliasyntax",
    "test:corpus": "tree-sitter test --wasm",
    "test:juliasyntax": "node test/juliasyntax/check.mjs",
    "test:native": "node --test bindings/node/*_test.js"
  }
}
